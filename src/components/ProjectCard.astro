---
interface Props {
  title: { en: string; es: string };
  desc: { en: string; es: string };
  bullets: { en: string; es: string }[];
  stack: string[];
  live?: string;
  images: string[];
  featured?: boolean;
}

const {
  title,
  desc,
  bullets,
  stack,
  live,
  images = [],
  featured = false,
} = Astro.props as Props;

const mainImage = images[0] ?? "/projects/placeholder.png";
const otherImages = images.slice(1);
const cardId = title.en.replace(/\s+/g, "-").toLowerCase();
---

<article
  class={`group overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg ${
    featured ? "lg:flex lg:gap-10 lg:p-10" : ""
  }`}
>
  <!-- image -->
  <div class="border-b border-zinc-200 p-3">
    <!-- 🔥 Imagen principal -->
    <img
      id={`main-img-${cardId}`}
      src={mainImage}
      alt={title.en}
      class="h-48 w-full object-cover rounded-lg cursor-pointer transition duration-300 hover:scale-[1.02] hover:brightness-90"
      data-images={JSON.stringify(images)}
      data-index="0"
      onclick="openGalleryFromElement(this)"
    />

    <!-- 🔥 SOLO otras imágenes -->
    {
      otherImages.length > 0 && (
        <div class="flex gap-2 mt-2">
          {otherImages.map((img, i) => (
            <img
              src={img}
              class="thumb w-16 h-16 object-cover rounded-md cursor-pointer border border-zinc-200 transition hover:opacity-80 hover:scale-105"
              data-card={cardId}
              data-index={i + 1}
              onclick={`changeMainImage('${cardId}', \`${img}\`, ${i + 1})`}
            />
          ))}
        </div>
      )
    }
  </div>

  <!-- content -->
  <div class="p-6">
    <header>
      <h3
        class="text-base font-semibold tracking-tight"
        data-en={title.en}
        data-es={title.es}
      >
        {title.en}
      </h3>

      <p
        class="mt-2 text-sm leading-relaxed text-zinc-600"
        data-en={desc.en}
        data-es={desc.es}
      >
        {desc.en}
      </p>
    </header>

    <!-- bullets -->
    <ul class="mt-4 space-y-2 text-sm text-zinc-700">
      {
        bullets.map((b) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-400" />
            <span data-en={b.en} data-es={b.es}>
              {b.en}
            </span>
          </li>
        ))
      }
    </ul>

    <!-- stack -->
    <div class="mt-4 flex flex-wrap gap-2">
      {
        stack.map((s) => (
          <span class="rounded-full bg-zinc-100 px-3 py-1 text-[12px] text-zinc-700">
            {s}
          </span>
        ))
      }
    </div>

    <!-- buttons -->
    <div class="mt-5 flex flex-wrap gap-3">
      {
        live && (
          <a
            class="inline-flex items-center gap-2 rounded-xl bg-zinc-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-zinc-800"
            href={live}
            target="_blank"
            rel="noreferrer"
          >
            Demo ↗
          </a>
        )
      }
    </div>
  </div>
</article>
