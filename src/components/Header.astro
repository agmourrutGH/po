<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-zinc-200 bg-white/70 backdrop-blur transition-all duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="#" class="font-semibold tracking-tight">
      Agustin Mourrut<span class="text-zinc-400">.</span>
    </a>

    <!-- Navigation -->
    <nav class="hidden items-center gap-6 text-sm text-zinc-600 md:flex">
      <a href="#about" class="nav-link" data-en="About" data-es="Sobre mí"
        >About</a
      >
      <a
        href="#education"
        class="nav-link"
        data-en="Education"
        data-es="Educación">Education</a
      >
      <a href="#skills" class="nav-link" data-en="Skills" data-es="Habilidades"
        >Skills</a
      >
      <a
        href="#projects"
        class="nav-link"
        data-en="Projects"
        data-es="Proyectos">Projects</a
      >
      <a
        href="#experience"
        class="nav-link"
        data-en="Experience"
        data-es="Experiencia">Experience</a
      >
      <a href="#contact" class="nav-link" data-en="Contact" data-es="Contacto"
        >Contact</a
      >
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <a
        id="cvButton"
        href="/cv-agustin-mourrut-en.pdf"
        data-en="Curriculum"
        data-es="CV"
        class="rounded-xl border border-zinc-200 px-3 py-2 text-sm font-semibold hover:bg-zinc-50"
      >
        Curriculum
      </a>

      <button
        id="langToggle"
        class="rounded-xl border border-zinc-200 px-3 py-2 text-sm font-semibold hover:bg-zinc-50"
      >
        ES
      </button>
    </div>
  </div>
</header>

<script>
  function initLanguage() {
    const langButton = document.getElementById(
      "langToggle",
    ) as HTMLButtonElement | null;
    let lang = localStorage.getItem("lang") || "en";

    function applyLanguage() {
      document.querySelectorAll("[data-en]").forEach((el) => {
        const element = el as HTMLElement;
        const value = element.dataset[lang as "en" | "es"];
        if (value != null) element.textContent = value;
      });

      if (langButton) {
        langButton.textContent = lang === "en" ? "ES" : "EN";
      }
    }

    applyLanguage();

    if (langButton) {
      langButton.addEventListener("click", () => {
        lang = lang === "en" ? "es" : "en";
        localStorage.setItem("lang", lang);
        applyLanguage();
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLanguage);
  } else {
    initLanguage();
  }
</script>
