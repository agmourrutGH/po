---
const { title, titleEs, subtitle, subtitleEs } = Astro.props;
---

<header class="mb-10">

  <h2 class="text-2xl font-semibold tracking-tight" data-en={title} data-es={titleEs ?? title}>
    {title}
  </h2>

  {(subtitle || subtitleEs) && (
    <p class="mt-2 text-zinc-600" data-en={subtitle} data-es={subtitleEs ?? subtitle}>
      {subtitle}
    </p>
  )}

</header>